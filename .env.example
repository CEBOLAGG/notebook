# Connection string do MongoDB Atlas (ou local).
# Inclua o nome do banco no final, p.ex. /notebookcheck
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.mongodb.net/notebookcheck?retryWrites=true&w=majority"

# Token compartilhado com o app desktop. O cliente envia "Authorization: Bearer <token>".
# Sem este valor o endpoint POST /api/reports rejeita com 401.
INGEST_TOKEN="segredaotop"

# Token opcional para acesso à UI/leitura. Quando vazio, a UI fica pública.
DASHBOARD_TOKEN=""
